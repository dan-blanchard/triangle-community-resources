  <p>Map: <a href="https://leafletjs.com">Leaflet</a>, tiles &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors. Locations come from the source lists or the <a href="https://geocoding.geo.census.gov/">US Census geocoder</a> (some via OpenStreetMap Nominatim). Confidential locations are never mapped.</p>
</div></footer>

<script src="vendor/leaflet.js"></script>
<script src="vendor/leaflet.markercluster.js"></script>
<script>
(() => {
  const $ = (s) => document.querySelector(s);
  const $$ = (s) => [...document.querySelectorAll(s)];
  $('#controls').hidden = false; $('#viewtoggle').hidden = false;
  const q = $('#q'), nf = $('#nf'), lg = $('#lg');
  const nw = $('#nw') || {checked: false, addEventListener() {}};
  const COMMUNITY = new Set(['mutual_aid', 'cooperative', 'community_org']);
  const NEED_HELP = {{ cat_help|tojson }};
  const EMOJI = {{ emoji|tojson }};
  const towns = new Set(), needs = new Set(), types = new Set(), costs = new Set();

  // ---- region-wide listings serve every town: copy each into its A-Z spot in every town ----
  const pool = $('#rwpool');
  if (pool) {
    const byRid = {};
    pool.querySelectorAll('article.r').forEach(a => byRid[a.dataset.rid] = a);
    $$('i.rwslot').forEach(s => { const c = byRid[s.dataset.rid].cloneNode(true); c.removeAttribute('id'); s.replaceWith(c); });
    pool.remove();
  }

  // ---- state from the URL (?town=Durham&town=Raleigh&need=Food&need=Pet+Care…) ----
  const params = new URLSearchParams(location.search);
  [...params.getAll('town'), ...params.getAll('city')].forEach(t => { if (t !== 'Triangle-wide') towns.add(t); });
  params.getAll('need').forEach(n => needs.add(n));
  q.value = params.get('q') || '';
  const pick = (sel, v) => [...sel.options].some(o => o.value === v) ? v : '';
  // (older links used type=community and cost=notfree)
  const OPTS = id => new Set($$(`#${id}panel input`).map(b => b.value));
  const typeOpts = OPTS('type'), costOpts = OPTS('cost');
  params.getAll('type').concat(params.has('community') ? ['community'] : []).forEach(t =>
    (t === 'community' ? [...COMMUNITY] : [t]).forEach(v => typeOpts.has(v) && types.add(v)));
  params.getAll('cost').forEach(c =>
    (c === 'notfree' ? [...costOpts].filter(v => v !== 'free') : [c]).forEach(v => costOpts.has(v) && costs.add(v)));
  nf.checked = params.has('nofaith'); lg.checked = params.has('lgbtq'); nw.checked = params.has('new');
  const costOk = c => !costs.size || costs.has(c);
  const typeOk = t => !types.size || types.has(t);

  // ---- search: words match at word starts; multi-word prefers the exact phrase ----
  const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const wordRe = w => new RegExp('(^|[^a-z0-9])' + esc(w));
  let textOk = () => true;
  function buildSearch() {
    const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    if (!words.length) { textOk = () => true; return; }
    const all = words.map(wordRe);
    const byWords = t => all.every(r => r.test(t));
    if (words.length === 1) { textOk = byWords; return; }
    const phrase = new RegExp('(^|[^a-z0-9])' + words.map(esc).join('[\\s,.;:/-]+'));
    const byPhrase = t => phrase.test(t);
    textOk = $$('article.r').some(a => byPhrase(a.dataset.text)) ? byPhrase : byWords;
  }

  // ---- towns dropdown (multi-select) ----
  const dds = [];
  function dropdown(id, set) {
    const root = $(`#${id}dd`), btn = root.querySelector('.ddbtn'), panel = root.querySelector('.ddpanel');
    const boxes = [...panel.querySelectorAll('input[type=checkbox]')];
    const names = Object.fromEntries(boxes.map(b => [b.value, b.nextElementSibling.textContent]));
    const open = o => { panel.hidden = !o; btn.setAttribute('aria-expanded', o); };
    btn.addEventListener('click', () => { const o = panel.hidden; dds.forEach(d => d.open(false)); open(o); });
    panel.querySelector('[data-done]').addEventListener('click', () => open(false));
    panel.querySelector('[data-clear]').addEventListener('click', () => { set.clear(); apply(); });
    boxes.forEach(b => b.addEventListener('change', () => { b.checked ? set.add(b.value) : set.delete(b.value); apply(); }));
    dds.push({root, open, sync() {
      boxes.forEach(b => b.checked = set.has(b.value));
      const l = [...set].map(v => names[v] || v);
      btn.textContent = (!l.length ? btn.dataset.all : l.length <= 2 ? l.join(', ') : `${l.length} ${btn.dataset.many}`) + ' ▾';
      btn.classList.toggle('on', set.size > 0);
    }});
  }
  dropdown('town', towns); dropdown('type', types); dropdown('cost', costs);
  document.addEventListener('click', ev => dds.forEach(d => { if (!d.root.contains(ev.target)) d.open(false); }));
  document.addEventListener('keydown', ev => { if (ev.key === 'Escape') dds.forEach(d => d.open(false)); });

  // ---- needs (multi-select badges; a card shows if it meets ANY selected need) ----
  const toggleNeed = n => { needs.has(n) ? needs.delete(n) : needs.add(n); apply(); };
  $$('.needchip').forEach(c => c.addEventListener('click', () => toggleNeed(c.dataset.need)));
  $$('article .need').forEach(n => n.addEventListener('click', ev => { ev.preventDefault(); toggleNeed(n.dataset.need); }));
  $('#needclear').addEventListener('click', () => { needs.clear(); apply(); });

  function apply() {
    buildSearch();
    let shown = 0;
    $$('section.city').forEach(sc => {
      const cityOk = !towns.size || towns.has(sc.dataset.city);
      let cityShown = 0;
      sc.querySelectorAll('article.r').forEach(a => {
        const t = a.dataset.type;
        const ok = cityOk && (!needs.size || a.dataset.cats.split('|').some(c => needs.has(c)))
          && typeOk(t) && (!nf.checked || t !== 'faith_based') && costOk(a.dataset.cost)
          && (!lg.checked || a.dataset.lgbtq) && (!nw.checked || a.querySelector('.b-new'))
          && textOk(a.dataset.text);
        a.classList.toggle('hidden', !ok); if (ok) cityShown++;
      });
      sc.classList.toggle('hidden', !cityShown); shown += cityShown;
    });
    $('#empty').style.display = shown ? 'none' : 'block';

    // dropdown buttons + checkboxes
    dds.forEach(d => d.sync());
    // needs badges, card badges, sticky summary, descriptions
    $$('.needchip').forEach(c => c.setAttribute('aria-pressed', needs.has(c.dataset.need)));
    $$('article .need').forEach(n => n.classList.toggle('on', needs.has(n.dataset.need)));
    $('#needsum').hidden = !needs.size;
    $('#needsumtext').textContent = 'Needs: ' + [...needs].map(n => (EMOJI[n] || '') + ' ' + n).join(', ');
    const help = $('#needhelp');
    help.hidden = !needs.size;
    help.textContent = [...needs].map(n => `${EMOJI[n] || ''} ${n}: ${NEED_HELP[n] || ''}`).join('  ·  ');

    // show which card badges match the active filters
    $$('article button.b').forEach(b => b.classList.toggle('on',
      (b.dataset.f === 'type' && types.has(b.dataset.v)) || (b.dataset.f === 'cost' && costs.has(b.dataset.v)) ||
      (b.dataset.f === 'lgbtq' && lg.checked) || (b.dataset.f === 'new' && nw.checked)));
    if (view === 'map') drawMarkers();
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    towns.forEach(t => p.append('town', t));
    needs.forEach(n => p.append('need', n));
    types.forEach(t => p.append('type', t));
    costs.forEach(c => p.append('cost', c));
    if (nf.checked) p.set('nofaith', ''); if (lg.checked) p.set('lgbtq', ''); if (nw.checked) p.set('new', '');
    if (view === 'map') p.set('view', 'map');
    history.replaceState(null, '', p.toString() ? '?' + p : location.pathname);
  }

  // ---- map view ----
  let view = params.get('view') === 'map' ? 'map' : 'list';
  let map = null, cluster = null;
  const COLORS = {mutual_aid: '#2f6b3a', cooperative: '#2f6b3a', community_org: '#2f6b3a', faith_based: '#5b3f78', public: '#2b4f7a', nonprofit: '#2b4f7a'};
  function popupFor(a) {
    const div = document.createElement('div');
    div.className = 'pop';
    div.append(a.querySelector('.rhead').cloneNode(true), a.querySelector('.needs').cloneNode(true));
    const facts = a.querySelector('dl.facts').cloneNode(true);
    facts.querySelectorAll('dt').forEach(dt => { if (!['When', 'Where', 'Call'].includes(dt.textContent)) { dt.nextElementSibling.remove(); dt.remove(); } });
    div.append(facts);
    const more = document.createElement('a');
    more.href = a.id ? '#' + a.id : '#'; more.className = 'more'; more.textContent = 'Full details →';
    more.addEventListener('click', ev => { ev.preventDefault(); setView('list'); a.scrollIntoView({behavior: 'smooth', block: 'center'}); a.classList.add('flash'); setTimeout(() => a.classList.remove('flash'), 2000); });
    div.append(more);
    return div;
  }
  function drawMarkers() {
    if (!map) return;
    cluster.clearLayers();
    const pts = [], seen = new Set();
    $$('section.city:not(.hidden) article.r:not(.hidden)[data-lat]').forEach(a => {
      if (seen.has(a.dataset.rid)) return;  // region-wide listings appear under every town
      seen.add(a.dataset.rid);
      const ll = [+a.dataset.lat, +a.dataset.lon];
      pts.push(ll);
      const m = L.circleMarker(ll, {radius: 7, weight: 2, color: '#fff', fillColor: COLORS[a.dataset.type] || '#2b4f7a', fillOpacity: .95});
      m.bindPopup(() => popupFor(a), {maxWidth: 300});
      cluster.addLayer(m);
    });
    if (pts.length) map.fitBounds(pts, {padding: [30, 30], maxZoom: 15});
  }
  function setView(v) {
    view = v;
    $('#vlist').setAttribute('aria-pressed', v === 'list');
    $('#vmap').setAttribute('aria-pressed', v === 'map');
    $('#listview').hidden = v === 'map';
    $('#mapwrap').hidden = v !== 'map';
    if (v === 'map' && !map && window.L) {
      map = L.map('map', {scrollWheelZoom: true});
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'}).addTo(map);
      cluster = L.markerClusterGroup({showCoverageOnHover: false, maxClusterRadius: 45});
      map.addLayer(cluster);
      map.setView([35.87, -78.85], 10);
    }
    apply();
    // The map was hidden (zero size) until now: measure it, then fit the markers.
    if (map) setTimeout(() => { map.invalidateSize(); drawMarkers(); }, 0);
  }
  $('#vlist').addEventListener('click', () => setView('list'));
  $('#vmap').addEventListener('click', () => setView('map'));
  [q, nf, lg, nw].forEach(el => el.addEventListener('input', apply));
  // Any badge on a card filters to listings like it (click again to clear).
  $$('article button.b').forEach(b => b.addEventListener('click', () => {
    const f = b.dataset.f, v = b.dataset.v;
    const flip = (set, x) => set.has(x) ? set.delete(x) : set.add(x);
    if (f === 'type') flip(types, v);
    if (f === 'cost') flip(costs, v);
    if (f === 'lgbtq') lg.checked = !lg.checked;
    if (f === 'new') nw.checked = !nw.checked;
    apply();
    b.closest('article').scrollIntoView({block: 'center'});
  }));
  setView(view);
})();
</script>
</body>
</html>
