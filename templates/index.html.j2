<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Triangle Community Resources – free, mutual aid &amp; shared</title>
<meta name="description" content="Free and community-run resources in Durham, Raleigh, Chapel Hill, Carrboro and the rest of the Triangle: food, clothing, shelter, mutual aid, tool libraries, maker spaces and more. Updated daily.">
<style>
:root{
  --bg:#fbf8f1; --ink:#1f1d1a; --muted:#5d5850; --line:#e4ddcf; --card:#fff;
  --accent:#b8401f; --accent-ink:#fff; --green:#2f6b3a; --green-bg:#e5f0e3;
  --blue:#2b4f7a; --blue-bg:#e3ebf5; --gold-bg:#f8ecc9; --warn:#8a4b00; --warn-bg:#fdebd0;
}
*{box-sizing:border-box}
html{scroll-padding-top:7.5rem}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--blue)}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:1100px;margin:0 auto;padding:0 1rem}
header.top{background:var(--ink);color:#fff;padding:1.6rem 0 1.2rem}
header.top h1{margin:0;font:800 clamp(1.6rem,4vw,2.4rem)/1.1 Georgia,"Iowan Old Style",serif;letter-spacing:-.01em}
header.top p{margin:.5rem 0 0;color:#ddd6c8;max-width:60ch}
header.top .updated{font-size:.85rem;color:#bdb5a5;margin-top:.7rem}
.crisis{background:var(--accent);color:var(--accent-ink);font-size:.95rem}
.crisis .wrap{padding:.55rem 1rem;display:flex;flex-wrap:wrap;gap:.3rem 1.2rem}
.crisis a{color:#fff;font-weight:700}
.controls{position:sticky;top:0;z-index:5;background:rgba(251,248,241,.97);border-bottom:1px solid var(--line);backdrop-filter:blur(4px)}
.controls .wrap{display:flex;flex-wrap:wrap;gap:.5rem .75rem;align-items:center;padding:.6rem 1rem}
.controls input[type=search]{flex:1 1 220px;padding:.55rem .7rem;font-size:1rem;border:1.5px solid #cfc6b4;border-radius:8px;background:#fff}
.controls select{padding:.5rem;font-size:.95rem;border:1.5px solid #cfc6b4;border-radius:8px;background:#fff;max-width:100%}
.controls label.tog{font-size:.9rem;display:flex;gap:.35rem;align-items:center;white-space:nowrap}
.citynav{display:flex;flex-wrap:wrap;gap:.35rem;padding:.9rem 0 .2rem}
.citynav a{font-size:.88rem;text-decoration:none;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:999px;padding:.2rem .7rem}
.citynav a:hover{border-color:var(--ink)}
.citynav a.active{background:var(--ink);color:#fff;border-color:var(--ink)}
.citynav a.active small{color:#ddd6c8}
.townchip{display:inline-flex;align-items:center;background:var(--ink);color:#fff;border-radius:999px;font-size:.92rem;overflow:hidden}
.townchip[hidden]{display:none}
.townchip a{color:#fff;text-decoration:none;padding:.4rem .2rem .4rem .8rem;font-weight:600}
.townchip a::before{content:"Town: ";font-weight:400;color:#ddd6c8}
.townchip button{background:none;border:0;color:#fff;font-size:.95rem;padding:.4rem .7rem;cursor:pointer}
.citynav small{color:var(--muted)}
.hint{color:var(--muted);font-size:.9rem;margin:.6rem 0 0}
section.city{margin:2rem 0 2.5rem}
section.city>h2{font:800 1.9rem/1.1 Georgia,"Iowan Old Style",serif;margin:0 0 1rem;padding-bottom:.35rem;border-bottom:3px solid var(--ink)}
section.cat h3{font-size:1.05rem;text-transform:uppercase;letter-spacing:.06em;margin:1.4rem 0 .6rem;color:var(--accent)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:.75rem}
article.r{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:.85rem .95rem;display:flex;flex-direction:column;gap:.35rem}
article.r h4{margin:0;font-size:1.05rem;line-height:1.3}
article.r h4 a{color:var(--ink);text-decoration:none}
article.r h4 a:hover{text-decoration:underline}
.badges{display:flex;flex-wrap:wrap;gap:.3rem}
.b{font-size:.72rem;font-weight:700;border-radius:4px;padding:.08rem .4rem;letter-spacing:.02em}
.b-mutual_aid,.b-cooperative,.b-community_org{background:var(--green-bg);color:var(--green)}
.b-nonprofit,.b-public{background:var(--blue-bg);color:var(--blue)}
.b-faith_based{background:#eee8f3;color:#5b3f78}
.b-cost{background:var(--gold-bg);color:#6b4e00}
.b-new{background:var(--accent);color:#fff}
.desc{margin:0;font-size:.93rem;white-space:pre-line}
dl.facts{margin:0;font-size:.88rem;display:grid;grid-template-columns:auto 1fr;gap:.15rem .55rem}
dl.facts dt{color:var(--muted);font-weight:600}
dl.facts dd{margin:0;white-space:pre-line;overflow-wrap:anywhere}
.warn{font-size:.8rem;background:var(--warn-bg);color:var(--warn);border-radius:4px;padding:.15rem .45rem}
.src{font-size:.75rem;color:var(--muted);margin-top:auto;padding-top:.2rem}
.src a{color:var(--muted)}
.src .stale{color:var(--warn);font-weight:600}
.empty{display:none;padding:2rem;text-align:center;color:var(--muted)}
footer{border-top:1px solid var(--line);margin-top:3rem;padding:1.5rem 0 3rem;font-size:.9rem;color:var(--muted)}
footer h2{font-size:1rem;color:var(--ink)}
dl.facts dd.note{color:var(--muted);font-size:.84rem}
.needs{display:flex;flex-wrap:wrap;gap:.3rem}
.need{font-size:.78rem;text-decoration:none;color:var(--ink);background:#f3eee3;border:1px solid var(--line);border-radius:999px;padding:.05rem .5rem}
.need:hover,.need.on{border-color:var(--accent);background:#fbe7df}
.needhelp{font-size:.9rem;color:var(--muted);padding:0 1rem .55rem}
.needhelp[hidden]{display:none}
.hidden{display:none!important}
@media (max-width:700px){
  html{scroll-padding-top:1rem}
  .controls{position:static}
  .controls .wrap{display:grid;grid-template-columns:1fr 1fr;gap:.45rem}
  .controls input[type=search]{grid-column:1/-1}
  .controls label.tog{font-size:.85rem;white-space:normal}
  section.city>h2{font-size:1.6rem}
}
@media print{
  .controls,.citynav,.crisis a[href^=http]::after{display:none}
  body{background:#fff;font-size:11pt}
  header.top{background:#fff;color:#000;padding:0}
  header.top p,header.top .updated{color:#333}
  .grid{display:block}
  article.r{break-inside:avoid;border:none;border-bottom:1px solid #ccc;border-radius:0;padding:.4rem 0}
  section.city{break-before:page}
}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <h1>Triangle Community Resources</h1>
  <p>Free, community-run and mutual-aid resources across Durham, Raleigh, Chapel Hill, Carrboro and the rest of the Triangle. <strong>Take what you need.</strong> Share what you can.</p>
  <div class="updated">Updated {{ meta.generated }} · {{ meta.total }} resources · Grouped by town, then by need</div>
</div></header>

<div class="crisis" role="note"><div class="wrap">
  <span>In crisis? Call or text <a href="tel:988">988</a></span>
  <span>Find services: dial <a href="tel:211">2-1-1</a></span>
  <span>Domestic violence: <a href="tel:+18007997233">(800) 799-7233</a></span>
</div></div>

<div class="controls" id="controls" hidden><div class="wrap">
  <input type="search" id="q" placeholder="Search names, notes, addresses: e.g. showers, no ID, 27701…" aria-label="Search resources">
  <span class="townchip" id="townchip" hidden><a href="#towns" id="townname" title="Pick a different town"></a><button type="button" id="townclear" aria-label="Show all towns">✕</button></span>
  <select id="cat" aria-label="Need"><option value="">All needs</option>{% for group, cats in category_groups %}<optgroup label="{{ group }}">{% for c, em in cats %}{% if cat_counts[c] %}<option value="{{ c }}" title="{{ cat_help[c] }}">{{ em }} {{ c }} ({{ cat_counts[c] }})</option>{% endif %}{% endfor %}</optgroup>{% endfor %}</select>
  <label class="tog"><input type="checkbox" id="ma"> Mutual aid &amp; community-run only</label>
  <label class="tog"><input type="checkbox" id="nf"> Hide faith-based</label>
</div>
  <div class="wrap needhelp" id="needhelp" hidden></div>
</div>

<main class="wrap" id="top">
  <nav class="citynav" id="towns" aria-label="Filter by town">
    <a href="#top" data-city="" class="all" role="button" hidden>All towns</a>
    {% for c in by_city %}<a href="#{{ c|slug }}" data-city="{{ c }}" role="button" aria-pressed="false">{{ "Region-wide" if c == "Triangle-wide" else c }} <small>{{ city_counts[c] }}</small></a>{% endfor %}
  </nav>
  <p class="hint">Hours change. Call ahead when you can, and check the source link if something looks off. Each town is listed A–Z; green tags mark community-run groups. Tap a need on any card to see everything that meets it.</p>

  {% for city, cats in by_city.items() %}
  <section class="city" id="{{ city|slug }}" data-city="{{ city }}">
    <h2>{{ "Region-wide & mobile" if city == "Triangle-wide" else city }}</h2>
    {% for group, items in cats.items() if items %}
    <section class="cat">
      <div class="grid">
      {% for e in items %}
        <article class="r" data-type="{{ e.org_type }}" data-cats="{{ e.categories|join('|') }}" data-text="{{ (e.name ~ ' ' ~ e.description ~ ' ' ~ e.access ~ ' ' ~ e.hours ~ ' ' ~ e.categories|join(' ') ~ ' ' ~ e.notes ~ ' ' ~ e.address ~ ' ' ~ e.city ~ ' ' ~ e.url|domain ~ ' ' ~ org_label[e.org_type] ~ ' ' ~ cost_label[e.cost] ~ ' ' ~ e.phone)|lower }}">
          <h4>{% if e.url %}<a href="{{ e.url }}" rel="noopener">{{ e.name }}</a>{% else %}{{ e.name }}{% endif %}</h4>
          <div class="badges">
            {% if e.is_new %}<span class="b b-new">New</span>{% endif %}
            <span class="b b-{{ e.org_type }}">{{ org_label[e.org_type] }}</span>
            {% if e.cost != "unknown" %}<span class="b b-cost">{{ cost_label[e.cost] }}</span>{% endif %}
          </div>
          <div class="needs">{% for c in e.categories %}<a class="need" href="?need={{ c|urlencode }}" data-need="{{ c }}" title="{{ cat_help[c] }}"><span aria-hidden="true">{{ emoji[c] }}</span> {{ c }}</a>{% endfor %}</div>
          {% if e.description %}<p class="desc">{{ e.description|truncate(320)|linkify }}</p>{% endif %}
          <dl class="facts">
            {% if e.hours %}<dt>When</dt><dd>{{ e.hours|truncate(220)|linkify }}</dd>{% endif %}
            {% if e.address %}<dt>Where</dt><dd>{% set m = e|maps %}{% if m %}<a href="{{ m }}" rel="noopener">{{ e.address|truncate(160) }}</a>{% else %}{{ e.address|truncate(160) }}{% endif %}</dd>{% endif %}
            {% if e.phone %}<dt>Call</dt><dd><a href="tel:{{ e.phone|tel }}">{{ e.phone }}</a></dd>{% endif %}
            {% if e.url %}<dt>Web</dt><dd><a href="{{ e.url }}" rel="noopener">{{ e.url|domain }}</a></dd>{% endif %}
            {% if e.access %}<dt>Access</dt><dd>{{ e.access|truncate(240)|linkify }}</dd>{% endif %}
            {% if e.notes %}<dt>Note</dt><dd class="note">{{ e.notes|truncate(260)|linkify }}</dd>{% endif %}
          </dl>
          {% if e.link_warning %}<span class="warn">Website hasn't loaded for several days; call before going.</span>{% endif %}
          <div class="src">{{ e|sources }} · <a href="{{ e|report }}" rel="noopener">Report a change</a></div>
        </article>
      {% endfor %}
      </div>
    </section>
    {% endfor %}
  </section>
  {% endfor %}
  <p class="empty" id="empty">Nothing matches. Try fewer words or clear the filters.</p>
</main>

<footer><div class="wrap">
  <h2>About this page</h2>
  <p>Rebuilt every morning. Each day it re-pulls these live sources, merges them with a researched list of mutual aid, sharing and making spaces (found by web search and re-checked monthly), and tests every website link:</p>
  <ul>
    {% for s in meta.sources %}<li>{% if s.url %}<a href="{{ s.url }}">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}: {{ s.count }} entries{% if s.stale_parts %} <em>(source unreachable today; showing the last copy we got)</em>{% endif %}</li>{% endfor %}
  </ul>
  <p>What's included: free or pay-what-you-can resources open to the community. Mutual aid and community-run groups are tagged green; use "Mutual aid &amp; community-run only" to see just those. Paid thrift stores, for-profit businesses and programs that require religious participation are left out.</p>
  <p>Something wrong, closed, or missing? <a href="{{ repo }}/issues/new?template=report-change.yml">Report a change</a> or <a href="{{ repo }}/issues/new?template=suggest-resource.yml">suggest a resource</a>. Reports are public on GitHub, so don't include personal details.</p>
  <p>Share this page: <a href="flyer.html">printable flyer with QR code</a> · <a href="qr.png" download>QR code image</a></p>
  <p>Download the data: <a href="resources.csv">CSV</a> · <a href="resources.json">JSON</a></p>
</div></footer>

<script>
(() => {
  const $ = (s) => document.querySelector(s);
  const ctl = $('#controls'); ctl.hidden = false;
  const q = $('#q'), cat = $('#cat'), ma = $('#ma'), nf = $('#nf');
  const city = { value: '' };  // selected town ('' = all), set by the town badges
  const COMMUNITY = new Set(['mutual_aid', 'cooperative', 'community_org']);
  const NEED_HELP = {{ cat_help|tojson }};
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') || ''; city.value = params.get('city') || ''; cat.value = params.get('need') || '';
  ma.checked = params.has('community'); nf.checked = params.has('nofaith');
  const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  // Words match at the start of a word ("id" won't match inside "aid").
  const wordRe = w => new RegExp('(^|[^a-z0-9])' + esc(w));
  let textOk = () => true;
  function buildSearch() {
    const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    if (!words.length) { textOk = () => true; return; }
    const all = words.map(wordRe);
    const byWords = t => all.every(r => r.test(t));
    if (words.length === 1) { textOk = byWords; return; }
    // Multi-word: prefer the exact phrase ("no id", "sliding scale"); fall back to all words anywhere.
    const phrase = new RegExp('(^|[^a-z0-9])' + words.map(esc).join('[\\s,.;:/-]+'));
    const byPhrase = t => phrase.test(t);
    const anyPhrase = [...document.querySelectorAll('article.r')].some(a => byPhrase(a.dataset.text));
    textOk = anyPhrase ? byPhrase : byWords;
  }
  function apply() {
    buildSearch();
    let shown = 0;
    document.querySelectorAll('section.city').forEach(sc => {
      let cityShown = 0;
      // A town shows its own listings plus region-wide ones, which serve every town.
      const cityOk = !city.value || sc.dataset.city === city.value || sc.dataset.city === 'Triangle-wide';
      sc.querySelectorAll('section.cat').forEach(sk => {
        let catShown = 0;
        sk.querySelectorAll('article.r').forEach(a => {
          const t = a.dataset.type;
          const ok = cityOk && (!cat.value || a.dataset.cats.split('|').includes(cat.value))
            && (!ma.checked || COMMUNITY.has(t)) && (!nf.checked || t !== 'faith_based')
            && textOk(a.dataset.text);
          a.classList.toggle('hidden', !ok); if (ok) catShown++;
        });
        sk.classList.toggle('hidden', !catShown); cityShown += catShown;
      });
      sc.classList.toggle('hidden', !cityShown); shown += cityShown;
    });
    $('#empty').style.display = shown ? 'none' : 'block';
    document.querySelectorAll('.citynav a[data-city]').forEach(a => {
      const on = !!city.value && a.dataset.city === city.value;
      a.classList.toggle('active', on);
      if (a.hasAttribute('aria-pressed')) a.setAttribute('aria-pressed', on);
    });
    $('.citynav a.all').hidden = !city.value;
    $('#townchip').hidden = !city.value;
    document.querySelectorAll('.need').forEach(n => n.classList.toggle('on', n.dataset.need === cat.value));
    const help = $('#needhelp');
    help.hidden = !cat.value;
    if (cat.value) help.textContent = (NEED_HELP[cat.value] || '');
    $('#townname').textContent = city.value === 'Triangle-wide' ? 'Region-wide' : city.value;
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value); if (city.value) p.set('city', city.value); if (cat.value) p.set('need', cat.value);
    if (ma.checked) p.set('community', ''); if (nf.checked) p.set('nofaith', '');
    history.replaceState(null, '', p.toString() ? '?' + p : location.pathname);
  }
  [q, cat, ma, nf].forEach(el => el.addEventListener('input', apply));
  $('#townclear').addEventListener('click', () => { city.value = ''; apply(); });
  document.querySelectorAll('.need').forEach(n => n.addEventListener('click', ev => {
    ev.preventDefault();
    cat.value = cat.value === n.dataset.need ? '' : n.dataset.need;  // click again to clear
    apply();
  }));
  document.querySelectorAll('.citynav a').forEach(a => a.addEventListener('click', ev => {
    ev.preventDefault();
    city.value = (a.dataset.city && city.value !== a.dataset.city) ? a.dataset.city : '';  // click again to clear
    apply();
    document.querySelector('main').scrollIntoView({behavior: 'smooth'});
  }));
  apply();
})();
</script>
</body>
</html>
